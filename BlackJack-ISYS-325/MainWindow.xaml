<Window x:Class="BlackJack_ISYS_325.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:BlackJack_ISYS_325"
        mc:Ignorable="d"
        Title="BlackJack" Height="450" Width="800">

    <Window.Resources>
        <local:CardImageConverter x:Key="CardImageConverter"/>
    </Window.Resources>
    
    <Grid Background="DarkGreen">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="2*"/>
            <RowDefinition Height="2*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <StackPanel Grid.Row="0" Margin="30,10,0,15">
            <TextBlock Text="THE DEBUGGER'S DEN" FontSize="24" FontWeight="Bold" Foreground="Gold"/>
            <TextBlock Text="BlackJack with a suspiciously helpful deck inspector" FontSize="16" Foreground="White"/>
        </StackPanel>
        
        <GroupBox Grid.Row="1" Header="Dealer" Margin="30,10,30,10" Foreground="White" BorderBrush="White" BorderThickness="1">
            <Grid>
                <TextBlock x:Name="dealerScoreText" Text="Dealer Score: 0" Foreground="White" FontSize="13" FontWeight="Bold" Margin="0,5,30,0" HorizontalAlignment="Right" VerticalAlignment="Bottom"/>
                <ListBox ItemsSource="{Binding DealerHand}" Background="Transparent" BorderThickness="0">
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal"/>
                        </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>


                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Image Source="{Binding Converter={StaticResource CardImageConverter}}" Width="90" Height="130" Stretch="Uniform"/>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>
            
        </GroupBox>
        <GroupBox Grid.Row="2" Header="Player" Margin="30,10,30,10" Foreground="White" BorderBrush="White" BorderThickness="1">
            <Grid>
                <TextBlock x:Name="playerScoreText" Text="Player Score: 0" Foreground="White" FontSize="13" FontWeight="Bold" Margin="0,5,30,0" HorizontalAlignment="Right" VerticalAlignment="Bottom"/>
                <ListBox ItemsSource="{Binding PlayerHand}" Background="Transparent" BorderThickness="0">
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal"/>
                        </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>

                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Image Source="{Binding Converter={StaticResource CardImageConverter}}" Width="90" Height="130" Stretch="Uniform"/>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>
           
        </GroupBox>
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Center" Margin="30,10,30,10">
            <Button x:Name="hitButton" Content="Hit" Margin="10" Click="HitButton_Click"/>
            <Button x:Name="deckInspect" Content="Deck Inspector" Margin="10" Click="deckInspect_Click"/>
            <Button x:Name="newGameButton" Content="New Game" Margin="10" Click="NewGameButton_Click"/>
        </StackPanel>
    </Grid>
</Window>
